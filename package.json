{
  "name": "les-delices-de-mere-double",
  "packageManager": "npm@10.8.2",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "db:generate": "npm run generate --workspace @repo/db",
    "dev": "turbo run dev --parallel --filter=@repo/web --filter=@repo/worker",
    "generate": "turbo run generate --filter=@repo/web",
    "postinstall": "npm run db:generate && npm run web:prepare",
    "preview": "turbo run preview --filter=@repo/web",
    "typecheck": "turbo run typecheck",
    "web:prepare": "npm run prepare --workspace @repo/web"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "turbo": "^2.5.6",
    "typescript": "^5.9.3"
  }
}
